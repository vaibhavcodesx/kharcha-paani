# Copy to .env (gitignored) and fill in real values. The Secrets Gradle
# Plugin exposes each key as a BuildConfig field; this file supplies the
# defaults for any key missing from .env.

# Gemini API key for AI ingestion (text/voice, receipt OCR, PDF statements).
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase project base URL, without /rest/v1 (supabase-kt appends paths itself).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase publishable key (sb_publishable_...). Safe to ship in the client;
# data access is enforced by RLS, not by this key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Google Cloud *Web* OAuth client ID (not the Android one). Used as the
# serverClientId for Credential Manager, and must also be listed under
# Supabase > Authentication > Providers > Google > Client IDs.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
