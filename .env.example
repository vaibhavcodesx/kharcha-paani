# Copy to .env (gitignored) and fill in real values. The Secrets Gradle
# Plugin exposes each key as a BuildConfig field; this file supplies the
# defaults for any key missing from .env.
#
# Never leave a key empty in .env (e.g. `GOOGLE_WEB_CLIENT_ID=`): the plugin
# emits it unquoted and BuildConfig.java stops compiling. Delete the line
# instead so the placeholder below is used.

# No Gemini key here: it lives only on the server, as the gemini-proxy Edge Function secret
# GEMINI_API_KEY (plan T1.3). The app reaches Gemini through SUPABASE_URL below.

# Supabase project base URL, without /rest/v1 (supabase-kt appends paths itself).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase publishable key (sb_publishable_...). Safe to ship in the client;
# data access is enforced by RLS, not by this key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Google Cloud *Web* OAuth client ID (not the Android one). Used as the
# serverClientId for Credential Manager, and must also be listed under
# Supabase > Authentication > Providers > Google > Client IDs.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Crash reports (Firebase Crashlytics), from the Firebase project's Android app:
# Firebase console > Project settings > Your apps > the Android app (package com.vaibhav.kharchapaani).
# "App ID" (1:1234567890:android:abc...), "Web API key", and the project ID. Not secrets, but kept
# out of the repo like the rest. While these are placeholders, no crash report is ever sent.
FIREBASE_APP_ID=MY_FIREBASE_APP_ID
FIREBASE_API_KEY=MY_FIREBASE_API_KEY
FIREBASE_PROJECT_ID=MY_FIREBASE_PROJECT_ID
