<?xml version="1.0" encoding="utf-8"?>
<!-- The compact quick-add: two cells by one, fixed size. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:resizeMode="none"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_quick_add_compact"
    android:previewLayout="@layout/widget_quick_add_compact"
    android:description="@string/widget_compact_description"
    android:widgetCategory="home_screen" />
