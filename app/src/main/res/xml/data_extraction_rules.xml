<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12+ (API 31+). Keep in sync with
   backup_rules.xml, which covers older versions.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Supabase session (access + refresh token): never leaves the device it was issued on. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="supabase_auth.xml" />
        <!-- Bill photos: Auto Backup has a 25 MB quota and backs up nothing once it's exceeded, so a
             few hundred bills would stop the ledger itself being backed up. Device transfer has no
             such limit and keeps them. -->
        <exclude domain="file" path="receipts/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="supabase_auth.xml" />
    </device-transfer>
</data-extraction-rules>
