<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 and lower (API 30-). Android 12+ uses
   data_extraction_rules.xml instead; keep the two in sync.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Supabase session (access + refresh token). Restoring it onto another device would
         carry a live session there; the user signs in again instead. -->
    <exclude domain="sharedpref" path="supabase_auth.xml" />
    <!-- Bill photos: the 25 MB quota would otherwise stop the ledger itself being backed up
         (see data_extraction_rules.xml). -->
    <exclude domain="file" path="receipts/" />
</full-backup-content>
