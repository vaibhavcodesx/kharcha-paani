<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget card, as close to the app's glass as a launcher allows (RemoteViews can't blur).
  Four layers, all clipped to the 28dp large squircle radius:
    1. CharcoalSurface at 92%, so a hint of wallpaper comes through like the dock's glass;
    2. the warm amber glow from the top-left that the sign-in screen and Home use;
    3. a faint top sheen, the light catching the glass;
    4. a hairline light edge instead of a flat grey border.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EB181615" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0"
                android:centerY="0"
                android:gradientRadius="140%p"
                android:startColor="#2EFF7A3D"
                android:endColor="#00FF7A3D" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#12FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#29FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
