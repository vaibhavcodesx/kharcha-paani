<?xml version="1.0" encoding="utf-8"?>
<!-- The quick-add bar: the same glass as the card (widget_background), as a pill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EB181615" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0"
                android:centerY="0.5"
                android:gradientRadius="100%p"
                android:startColor="#29FF7A3D"
                android:endColor="#00FF7A3D" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#29FFFFFF" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</layer-list>
