{
  "kp-session-start": {
    "SessionStart": [
      { "type": "command", "command": "python hooks/guard.py --session", "timeout": 20 }
    ]
  },
  "kp-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content|multi_replace_file_content|grep_search",
        "hooks": [
          { "type": "command", "command": "python hooks/guard.py", "timeout": 30 }
        ]
      }
    ]
  }
}
